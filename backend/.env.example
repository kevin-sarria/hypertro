PORT=4000
NODE_ENV=development

# Base de datos MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_USER=hypertro_user
DB_PASSWORD=hypertro_secret_password
DB_NAME=hypertro_db
DB_POOL_LIMIT=10

# Autenticación y JWT
JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_chars_long
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_chars_long
JWT_ISSUER=hypertro-auth

# CORS y Seguridad
CORS_ORIGIN=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Servidor SMTP de correos
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=smtp_username
SMTP_PASS=smtp_password
MAIL_FROM="Hypertro Support <no-reply@hypertro.app>"

# URL pública de la aplicación cliente
APP_URL=http://localhost:5173
